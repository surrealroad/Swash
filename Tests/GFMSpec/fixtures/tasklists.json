{
  "section": "5.3 Task list items (extension)",
  "cases": [
    {
      "id": "tasklist-basic",
      "example": 279,
      "description": "Basic task list with unchecked and checked items",
      "markdown": "- [ ] foo\n- [x] bar",
      "expectedItems": [
        { "isChecked": false, "indentLevel": 0, "text": "foo" },
        { "isChecked": true, "indentLevel": 0, "text": "bar" }
      ]
    },
    {
      "id": "tasklist-case-insensitive",
      "example": 280,
      "description": "Task list with uppercase X for checked state",
      "markdown": "- [ ] pending\n- [X] completed with uppercase X",
      "expectedItems": [
        { "isChecked": false, "indentLevel": 0, "text": "pending" },
        { "isChecked": true, "indentLevel": 0, "text": "completed with uppercase X" }
      ]
    },
    {
      "id": "tasklist-nested",
      "example": 281,
      "description": "Nested task list with child indentation",
      "markdown": "- [ ] Root task\n  - [x] Child task 1\n  - [ ] Child task 2",
      "expectedItems": [
        { "isChecked": false, "indentLevel": 0, "text": "Root task" },
        { "isChecked": true, "indentLevel": 1, "text": "Child task 1" },
        { "isChecked": false, "indentLevel": 1, "text": "Child task 2" }
      ]
    },
    {
      "id": "tasklist-mixed-asterisk",
      "example": 282,
      "description": "Task list using asterisk bullets",
      "markdown": "* [ ] Item A\n* [x] Item B",
      "expectedItems": [
        { "isChecked": false, "indentLevel": 0, "text": "Item A" },
        { "isChecked": true, "indentLevel": 0, "text": "Item B" }
      ]
    },
    {
      "id": "tasklist-plus-bullet",
      "example": 283,
      "description": "Task list using plus bullets",
      "markdown": "+ [ ] Plus task unchecked\n+ [x] Plus task checked",
      "expectedItems": [
        { "isChecked": false, "indentLevel": 0, "text": "Plus task unchecked" },
        { "isChecked": true, "indentLevel": 0, "text": "Plus task checked" }
      ]
    }
  ]
}
